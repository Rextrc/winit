// WinIt — simulated casino. All balances are fake currency stored as integer
// "cents" so no floating point drift can ever create or destroy money.
// There is no payment provider, no deposit path and no cash-out path anywhere
// in this schema by design.
//
// Money columns are BigInt rather than Int: the rebirth system scales table
// limits geometrically, and SQLite's Prisma `Int` is hard-capped at 2^31 cents
// (~21.4M), which a rebirthed player would overflow. Application code keeps
// working in JS `number` (exact to 2^53 cents = ~90 trillion) and converts at
// the Prisma boundary only — see src/lib/bigmoney.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String
  // Fake currency only. Seeded with 100,000.00 on sign-up.
  balanceCents BigInt   @default(10000000)
  lastBonusAt  DateTime?

  // --- Referrals -----------------------------------------------------------
  // Every account owns one shareable code. referredById names the account whose
  // code was used at sign-up, and is set once and never changed.
  referralCode String?   @unique
  referredById String?
  referredAt   DateTime?
  // The address the account was created from. Used to refuse a referral
  // between two accounts made on the same connection.
  signupIp     String?

  // --- Enforcement ---------------------------------------------------------
  // Strikes are cumulative and never expire on their own. Three suspends the
  // account; a fourth bans it outright. Staff clear both by unsuspending.
  strikes      Int       @default(0)
  bannedAt     DateTime?
  bannedReason String?
  bonusStreak  Int      @default(0)
  createdAt    DateTime @default(now())

  // --- Life progression ---------------------------------------------------
  // Career XP earned since the last rebirth. Levels raise the table limit and
  // unlock features; a rebirth resets level/xp and permanently multiplies the
  // ceiling. See src/lib/progression.ts for the curve.
  xp       Int @default(0)
  level    Int @default(1)
  rebirths Int @default(0)

  // Career totals, kept across rebirths. BigInt because a long-lived account
  // can wager far past 2^31 cents.
  lifetimeWageredCents BigInt @default(0)
  lifetimeWonCents     BigInt @default(0)
  biggestWinCents      BigInt @default(0)
  // Best payout multiplier ever hit, stored x100 so it stays an integer.
  bestMultiplierX100   Int    @default(0)

  // --- The career ----------------------------------------------------------
  // A life is a budget of days that every settled bet spends. When it runs out
  // — or the player goes broke once too often — the career ends and the next
  // one starts from scratch. See src/lib/life/career.ts.
  careerDays      Int      @default(0)
  careerStartedAt DateTime @default(now())
  betsThisLife    Int      @default(0)
  venueId         String   @default("back-room")
  comebacksUsed   Int      @default(0)
  // "RUIN" | "OLD_AGE" once the career is over, null while it is running.
  deathCause    String?
  diedAt        DateTime?
  // Completed careers. Each one makes the next quicker to build.
  livesLived    Int     @default(0)
  // Highest balance this life ever reached — the headline on the headstone.
  peakBalanceCents BigInt @default(10000000)

  // --- Progression layer ---------------------------------------------------
  // Reputation is per-life and can go DOWN — random events take it, and losing
  // it can close a door you had already walked through. See lib/life/reputation.
  reputation      Int    @default(0)
  // Rooms this life has actually placed a bet in, as a JSON array of venue ids.
  visitedVenuesJson String @default("[\"back-room\"]")
  // Random-event rate cap, reset when the UTC day key changes.
  eventsToday     Int    @default(0)
  eventDayKey     String @default("")

  // --- Staff, moderation and presence -------------------------------------
  // Null for a normal player. Set only by the seed script or by an OWNER —
  // there is deliberately no self-serve path to a role. See lib/admin/roles.
  adminRole       String?
  suspendedAt     DateTime?
  suspendedReason String?
  // Soft delete: the row stays for the audit trail, but the account cannot be
  // signed into and is hidden from the player-facing app.
  deletedAt       DateTime?
  // Throttled presence stamp, for "online now" and daily-active counts.
  lastSeenAt      DateTime?

  transactions Transaction[]
  rounds       Round[]
  lives        Life[]
  gameStats    GameStat[]
  achievements AchievementUnlock[]
  challenges   ChallengeProgress[]
  events       LifeEvent[]
  auditEntries AuditLog[] @relation("AuditActor")

  @@index([adminRole])
  @@index([deletedAt])

  strikeLog Strike[]

  @@index([referredById])
  @@index([signupIp])
}

// Every consequential staff action, with enough detail to answer "who changed
// this, from what, to what, and why" without reading application logs.
// Append-only: nothing in the app updates or deletes a row here.
model AuditLog {
  id String @id @default(cuid())

  actorId       String
  actor         User   @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)
  actorUsername String
  actorRole     String

  // e.g. "account.balance.set", "account.suspend", "game.disable"
  action String

  // The account acted on, when the action targets one. Denormalised username
  // so the entry still reads correctly if the account is later renamed.
  targetId       String?
  targetUsername String?

  // What moved. Stored as strings so one table covers money, levels and flags.
  field    String?
  oldValue String?
  newValue String?

  // Required by every mutating route — an unexplained change is not allowed.
  reason String

  metadata  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetId])
  @@index([actorId])
  @@index([action])
}

// Per-game operational config, editable from the dashboard rather than by
// redeploying. Absent row = the registry defaults, so this table only ever
// holds deliberate overrides.
model GameConfig {
  slug    String  @id
  enabled Boolean @default(true)
  // Overrides for the table limits. Null means "use the normal rules".
  minBetCentsOverride BigInt?
  maxBetCentsOverride BigInt?
  // Shown to players when the game is switched off.
  disabledNote String?

  updatedAt   DateTime @updatedAt
  updatedById String?
}

// Site-wide switches and feature flags, one row per key. Kept as strings so a
// flag can hold a boolean, a number or a short message without a migration.
model SiteFlag {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedById String?
}

// A message pushed to every player, or to one account.
// A player's dismissal of one announcement. Kept as a row rather than in the
// browser so a message stays read across devices and sign-ins.
model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

model Announcement {
  id       String  @id @default(cuid())
  title    String
  body     String
  // "INFO" | "WARNING" | "CELEBRATION"
  level    String  @default("INFO")
  // Null targets everyone; set targets a single account.
  targetId String?
  active   Boolean @default(true)

  createdById String
  createdBy   String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  reads AnnouncementRead[]

  @@index([active, targetId])
}

// A redeemable code. Redemptions are recorded so a code cannot be used twice
// by the same account, and so the payout is auditable.
model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique
  grantCents BigInt  @default(0)
  grantXp   Int      @default(0)
  // 0 means unlimited.
  maxRedemptions Int @default(0)
  redeemedCount  Int @default(0)
  active    Boolean  @default(true)
  expiresAt DateTime?

  createdById String
  createdBy   String
  createdAt   DateTime @default(now())

  redemptions PromoRedemption[]
}

model PromoRedemption {
  id     String @id @default(cuid())
  codeId String
  code   PromoCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  userId String
  redeemedAt DateTime @default(now())

  @@unique([codeId, userId])
  @@index([userId])
}

// Per-game counters, so achievements and the developer analytics can ask
// "how many hands of blackjack" without scanning the whole transaction log.
model GameStat {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The engine key used in the ledger: "roulette", "slots", "crash", ...
  game String

  bets            Int    @default(0)
  wins            Int    @default(0)
  wageredCents    BigInt @default(0)
  wonCents        BigInt @default(0)
  biggestWinCents BigInt @default(0)
  bestMultiplierX100 Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, game])
  @@index([userId])
}

// An achievement is unlocked the first time its own predicate returns true.
// Written once, never updated — see lib/life/achievements.
model AchievementUnlock {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

// Progress against one challenge in one period. The board itself is derived
// from the period key rather than stored, so only progress lives here.
model ChallengeProgress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key    String
  // "daily" | "weekly"
  period String
  // "2026-09-01" or "2026-W36"
  periodKey String

  progress Int     @default(0)
  target   Int
  claimed  Boolean @default(false)

  // Distinct games seen this period, for the DISTINCT_GAMES metric.
  seenJson String @default("[]")

  updatedAt DateTime @updatedAt

  @@unique([userId, key, period, periodKey])
  @@index([userId, periodKey])
}

// A random event. Choice events sit PENDING until the player decides; the
// money only moves on resolution, and always through the ledger.
model LifeEvent {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key    String
  // "PENDING" | "RESOLVED"
  status String @default("PENDING")

  choiceKey  String?
  outcomeText String?
  // The stake that triggered this event — an effect is capped against it, so
  // farming events at the minimum bet cannot pay out against a big limit.
  stakeCents BigInt @default(0)
  netCents   BigInt @default(0)
  reputationDelta Int @default(0)
  daysDelta  Int    @default(0)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, status])
}

// A finished career, kept for the hall of lives. Written once when a life ends
// and never updated — these are gravestones, not state.
model Life {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 1 for the first career on the account, 2 for the next, and so on.
  ordinal Int
  // "RUIN" | "OLD_AGE"
  cause    String
  ageAtEnd Int
  level    Int
  rebirths Int
  venueId  String
  epitaph  String

  peakBalanceCents     BigInt
  lifetimeWageredCents BigInt
  biggestWinCents      BigInt
  betsPlaced           Int    @default(0)

  startedAt DateTime
  endedAt   DateTime @default(now())

  @@index([userId, ordinal])
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "slots" | "blackjack" | "roulette" | "bonus" | "signup" | "rebirth"
  game String
  // "BET" | "BONUS" | "SIGNUP" | "REBIRTH"
  kind String

  betCents    BigInt
  payoutCents BigInt
  // payoutCents - betCents. Positive on a win, negative on a loss.
  netCents    BigInt

  // "WIN" | "LOSS" | "PUSH" | "CREDIT"
  outcome String
  // Short human readable result, e.g. "BAR / BAR / BAR x60" or "21 vs 19".
  summary String

  // Running balance after this row was applied.
  balanceAfterCents BigInt

  // JSON blob with the full game result (reels, cards, wheel pocket, ...)
  detail String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Multi-step game state (blackjack hands live here between actions so the
// client can never tell the server what it drew).
model Round {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  game     String
  // "ACTIVE" | "SETTLED"
  status   String @default("ACTIVE")
  betCents BigInt
  state    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// One recorded infraction. Append-only: a strike is never edited or deleted,
// so the count on User is always reproducible from these rows.
model Strike {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "referral.self" today; the column is free text so a new rule needs no migration.
  kind      String
  reason    String
  // What the account was at after this strike: "WARNED" | "SUSPENDED" | "BANNED".
  outcome   String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
