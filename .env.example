# Copy to .env before running.
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public site origin (no trailing slash). Used only to build absolute URLs for
# the sitemap, robots.txt and social-share metadata — never for auth or data.
# Falls back to NEXTAUTH_URL if unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
