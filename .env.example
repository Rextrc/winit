# Copy to .env before running.
DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public site origin (no trailing slash). Used only to build absolute URLs for
# the sitemap, robots.txt and social-share metadata — never for auth or data.
# Falls back to NEXTAUTH_URL if unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sports betting — real matches and bookmaker odds from The Odds API.
# Get a key at https://the-odds-api.com. Each league refresh costs 3 credits
# and each results check 2; the free tier (500/month) only covers light use.
ODDS_API_KEY=""
# How long odds are cached before a page view refetches them (default 20).
ODDS_CACHE_MINUTES="20"
# Settlement runs inside the server every 5 minutes on its own. Set this only
# if you also want to trigger it externally: POST /api/sports/settle with
# "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=""

# Cloudflare Turnstile — CAPTCHA on signup and login. Get both keys from the
# same entry at https://dash.cloudflare.com → Turnstile → Add Site (pick the
# "Managed" widget type). Both are unset by default, which turns Turnstile
# off entirely: no widget renders and the server doesn't require a token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
